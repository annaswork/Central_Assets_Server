# ==============================================================================
# Git Ignore Configuration for Creative Asset Library & Admin App
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions & distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.secret

# Temporary Storage, Scratch & Uploads
.tmp/
*.tmp
*.temp
scratch/

# Runtime Dynamic Media / User Uploads & New Data
static/central_data/**
!static/central_data/
!static/central_data/.gitkeep
static/app_data/**
!static/app_data/
!static/app_data/.gitkeep
static/profiles/**
!static/profiles/
!static/profiles/.gitkeep
static/proposals/**
!static/proposals/
!static/proposals/.gitkeep
static/cache/**
!static/cache/
!static/cache/.gitkeep
!static/thumbnail_default.png

# Reports, Documents & Exports
*.doc
*.docx
*.pdf
*.xlsx
*.xls
*.csv

# Database Dumps & Backups
dump/
backups/
*.dump
*.tar
*.tar.gz
*.zip
*.sqlite3
*.db

# Unit test & coverage reports
.pytest_cache/
tests/
test/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/

# Code quality & linters
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# IDEs, Editors & Tooling
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.directory

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Logs
*.log
logs/
