# ==============================================================================
# Git Ignore Configuration for Creative Asset Library & Admin App
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions & distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.secret

# Temporary Storage & Uploads
.tmp/
*.tmp
*.temp

# Runtime Dynamic Media / User Uploads (keep directory structure if needed)
static/central_data/*
!static/central_data/.gitkeep
static/app_data/*
!static/app_data/.gitkeep
static/profiles/*
!static/profiles/.gitkeep

# Unit test & coverage reports
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/

# Code quality & linters
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# IDEs, Editors & Tooling
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.directory

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Logs and databases
*.log
logs/
*.sqlite3
*.db
