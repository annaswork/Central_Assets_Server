# Environment
ENV=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=admin_assets_db

# Security & Secrets
SECRET_KEY=change_this_to_a_secure_random_string_in_production_min_32_chars
ADMIN_SESSION_SECRET=change_this_admin_session_secret_in_production_min_32_chars
ADMIN_SESSION_COOKIE_NAME=admin_session
ADMIN_SESSION_MAX_AGE_SECONDS=86400

# CORS Origins (JSON array or comma-separated)
CORS_ORIGINS=["*"]

# Analytics
ANALYTICS_QUEUE_MAX_SIZE=10000
ANALYTICS_BATCH_SIZE=100
ANALYTICS_FLUSH_INTERVAL_SECONDS=2.0
ANALYTICS_DEFAULT_RETENTION_DAYS=30

# Initial Admin Operator (First-run bootstrap)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin_password_to_change_immediately

# API Documentation Auth (HTTP Basic Auth for /docs, /redoc, /openapi.json)
DOCS_USERNAME=admin
DOCS_PASSWORD=admin_docs_password_to_change
